{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/search", "dest": "api/index.py" },
    { "src": "/search/stream", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
