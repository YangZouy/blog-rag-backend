# ---- Qdrant ----
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION=blog_chunks

# ---- Embedding (default 智谱 embedding-3, 2048-dim) ----
EMBED_MODEL=embedding-3
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBED_DIM=2048
EMBED_BATCH_SIZE=64
ZHIPU_API_KEY=your-zhipu-key
QDRANT_UPSERT_BATCH_SIZE=32
QDRANT_WRITE_TIMEOUT=120
QDRANT_READ_TIMEOUT=3
# Establish the remote connection at server startup to avoid first-query TLS latency.
QDRANT_WARMUP_ENABLED=true

# ---- Generation (DeepSeek-chat) ----
GEN_MODEL=deepseek-chat
GEN_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-key

# ---- Reranker (Jina Reranker v2 multilingual API) ----
JINA_API_KEY=your-jina-key

# ---- Retrieval tuning ----
RETRIEVAL_CANDIDATE_K=8
GENERATION_CONTEXT_K=3
RERANK_RELEVANCE_THRESHOLD=0.30

# ---- API hardening ----
# 留空 = 关闭 key 校验；设置后客户端需带 x-api-key 或 ?api_key=
API_KEY=
ALLOWED_ORIGINS=https://yangzouy.github.io
RATE_LIMIT_PER_MIN=10
CACHE_TTL=600

# ---- Misc ----
SITE_URL=https://yangzouy.github.io
LOG_LEVEL=INFO
